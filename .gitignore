target/
*.class
*.jar
*.war
*.ear
*.rar

# Maven
.mvn/
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
backend/.mvn/
backend/mvnw
backend/mvnw.cmd

# ------------------------------------------
