# ------------------------------------------
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
dist/
.vite/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

